# WLED
WLED_URL=http://wled.local
WLED_LED_COUNT=300
WLED_TOP_AT_HIGH_INDEX=true
WLED_PIXELS_PER_MARK=18
WLED_GAP_WIDTH=8

# LedFx on macOS
LEDFX_URL=http://127.0.0.1:8889
# Leave blank to discover /Applications/LedFx*.app automatically.
LEDFX_APP=
LEDFX_CONFIG_DIR=$HOME/.ledfx
LEDFX_VIRTUAL_ID=office-wled
LEDFX_AUDIO_DEVICE_MATCH=BlackHole 2ch
LEDFX_SCENE_ENERGY=music-energy
LEDFX_SCENE_SPECTRUM=music-spectrum
LEDFX_SCENE_WAVELENGTH=music-wavelength

# Optional Home Assistant energy summary
HA_DB_PATH=/config/home-assistant_v2.db
HA_ENERGY_STATISTIC_ID=energy:replace_with_your_statistic_id
HA_TIMEZONE=UTC
HA_HIGH_USAGE_MULTIPLIER=1.25
