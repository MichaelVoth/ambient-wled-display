{
  "renderer_url": "http://raspberrypi.local:8090",
  "bind": "0.0.0.0",
  "port": 8091,
  "ffmpeg": "/opt/homebrew/bin/ffmpeg",
  "audio_input": "BlackHole 2ch",
  "audio_route_tool": "./audio-route",
  "capture_backend": "ledfx",
  "ledfx_url": "http://127.0.0.1:8889",
  "ledfx_app": "/Applications/LedFx-2.1.5.app",
  "ledfx_config_dir": "~/.ledfx",
  "routes": [
    {"id": "airpods", "label": "AirPods + WLED", "device": "AirPods + WLED"},
    {"id": "office", "label": "Office + WLED", "device": "Office + WLED"},
    {"id": "laptop", "label": "MacBook Speakers + WLED", "device": "MacBook Speakers + WLED"}
  ]
}
